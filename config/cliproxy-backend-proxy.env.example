# Environment used by systemd. Keep this file mode 600 on the server.
# The explicit proxy-url in config.yaml is still required for Codex uTLS requests.

http_proxy=http://127.0.0.1:7890
https_proxy=http://127.0.0.1:7890
all_proxy=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
HTTPS_PROXY=http://127.0.0.1:7890
ALL_PROXY=http://127.0.0.1:7890
no_proxy=127.0.0.1,localhost
NO_PROXY=127.0.0.1,localhost
